{
  "name": "pi-deepseek-optimized",
  "version": "1.0.1",
  "description": "Harness techniques for DeepSeek V4 Pro on the pi coding agent (cache stability, storm-breaker, hashline editing, plan mode, rewind).",
  "license": "BSD-3-Clause",
  "author": "Jason Rimmer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrimmer/pi-deepseek-optimized.git"
  },
  "homepage": "https://github.com/jrimmer/pi-deepseek-optimized#readme",
  "bugs": {
    "url": "https://github.com/jrimmer/pi-deepseek-optimized/issues"
  },

  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "harness",
    "deepseek",
    "cache",
    "edit-lines",
    "storm-breaker",
    "plan-mode",
    "rewind"
  ],
  "pi": {
    "extensions": [
      "./extensions/harness.ts"
    ]
  },
  "files": [
    "LICENSE",
    "README.md",
    "extensions",
    "tsconfig.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "pack:dry": "npm pack --dry-run",
    "verify": "npm run typecheck && npm test && npm run pack:dry"
  }
}